        primary_key=True,
    )
    assigned_at: Mapped[datetime] = mapped_column(
        DateTime,
        default=datetime.utcnow,
        nullable=False,
    )


class CompanyApplication(Base):
    __tablename__ = "company_applications"

    company_id: Mapped[int] = mapped_column(
        Integer,
